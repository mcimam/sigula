node_modules/
dist/
build/
.react-router/
target/
out/
__pycache__/
*.pyc
.venv/
venv/
vendor/
.gradle/
bin/
obj/

# Local SQLite + runtime data
data/*
!data/.gitkeep
*.sqlite3
*.db
*.db-shm
*.db-wal

# Logs, coverage, test caches
*.log
npm-debug.log*
.coverage
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.vitest/

# Editor / OS
.DS_Store
Thumbs.db
