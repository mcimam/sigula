# Agent scaffold
.agents/settings.local.json
.agents/work/notes/*
!.agents/work/notes/.gitkeep
.claude/settings.local.json

# Secrets — never committed
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*

